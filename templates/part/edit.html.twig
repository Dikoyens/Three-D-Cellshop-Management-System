{% extends 'base.html.twig' %}

{% block title %}Edit Part | {{ parent() }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-black text-gray-100 flex items-center justify-center py-10">
    <div class="w-full max-w-2xl bg-zinc-900 rounded-2xl shadow-xl border border-zinc-800">
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-zinc-800 p-6">
            <h1 class="text-2xl font-semibold text-white">Edit Part</h1>
            <a href="{{ path('app_part_index') }}" 
               class="text-sm font-medium text-red-500 hover:text-red-400 transition-colors">
                ← Back to List
            </a>
        </div>

        <!-- Form -->
        <div class="p-6 space-y-6">
            {{ include('part/_form.html.twig', {'button_label': 'Update'}) }}
        </div>

        <!-- Footer -->
        <div class="border-t border-zinc-800 p-6 flex justify-end">
            {{ include('part/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
