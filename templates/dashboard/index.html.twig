{% extends 'base.html.twig' %}

{% block title %}TechTrack Dashboard{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="dashboard-wrapper">
    <div class="dashboard-header">
        <h1>Three D Cellshop Dashboard 📱</h1>
        <div class="nav-links">
            <a>Orders</a>
            <a>Customers</a>
            <a>Reports</a>
            <a>Settings</a>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="card">
            <h2>🛒 Total Orders</h2>
            <p>120 this month</p>
        </div>
        <div class="card">
            <h2>👥 Customers</h2>
            <p>85 active customers</p>
        </div>
        <div class="card">
            <h2>📈 Revenue</h2>
            <p>₱250,000 this month</p>
        </div>
        <div class="card">
            <h2>⚙️ System Status</h2>
            <p>All services running smoothly</p>
        </div>
    </div>

{% endblock %}
