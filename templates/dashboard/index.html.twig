{% extends 'base_dashboard.html.twig' %}

{% block title %}Three D Cellshop - Dashboard{% endblock %}

{% block body %}
<h1 class="text-3xl font-bold text-red-600 mb-6"> Three D Cellshop Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
  {% set cards = [
    { title: 'Stock Parts', count: parts_count, path: 'app_part_index', label: 'View Parts' },
    { title: 'Cellphone Categories', count: categories_count, path: 'app_category_index', label: 'View Categories' },
    { title: 'Deliveries', count: deliveries_count, path: 'app_delivery_index', label: 'View Deliveries' },
    { title: 'Repair Records', count: repairs_count, path: 'app_repair_record_index', label: 'View Repairs' }
  ] %}

  {% for card in cards %}
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-lg hover:border-red-500 transition">
      <h2 class="text-gray-400 text-sm font-medium uppercase mb-2">{{ card.title }}</h2>
      <p class="text-3xl font-bold text-white">{{ card.count }}</p>
      <a href="{{ path(card.path) }}" class="text-sm text-red-500 hover:text-red-400 transition">{{ card.label }}</a>
    </div>
  {% endfor %}
</div>

<div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-lg p-6">
  <h2 class="text-xl font-semibold text-white mb-4">Recent Activity</h2>

  <table class="w-full border-collapse text-white">
    <thead class="border-b border-zinc-800">
      <tr class="text-gray-300">
        <th class="py-3 text-left text-red-600">Date</th>
        <th class="py-3 text-left text-red-600">Action</th>
        <th class="py-3 text-left text-red-600">Entity</th>
        <th class="py-3 text-left text-red-600">User</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-800">
      {% for log in recent_activity %}
        <tr class="hover:bg-zinc-800 transition">
          <td class="py-3">{{ log.date|date('Y-m-d H:i') }}</td>
          <td class="py-3">{{ log.action }}</td>
          <td class="py-3">{{ log.entity }}</td>
          <td class="py-3">{{ log.user }}</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" class="py-6 text-center text-gray-500">No recent activity</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
