{% extends 'base_dashboard.html.twig' %}

{% block title %}3D Cellshop - Cellphone Parts{% endblock %}

{% block body %}
<section class="bg-gray-900 text-red-700 min-h-screen py-2 px-2">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-extrabold text-center text-red-600 mb-10 font-serif">Phone Categories</h1>

    <div class="overflow-x-auto bg-zinc-900  rounded-lg shadow-lg border border-red-600">
      <table id="categoryTable"class="w-full text-sm text-left bg-white">
        <thead class="text-black bg-red-600">
          <tr>
            <th class="py-3 px-6 font-semibold font-serif">ID</th>
            <th class="py-3 px-6 font-semibold font-serif">Name</th>
            <th class="py-3 px-6 font-semibold font-serif text-center">Actions</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-zinc-800 bg-zinc-900">
          {% for category in categories %}
            <tr class="hover:bg-gray-500 transition-colors">
              <td class="py-3 px-6 text-white">{{ category.id }}</td>
              <td class="py-3 px-6 text-white">{{ category.name }}</td>
              <td class="py-3 px-6 text-center space-x-3">
                <a href="{{ path('app_category_show', {'id': category.id}) }}" 
                   class="text-green-600 hover:text-green-700 font-semibold transition">Show</a>
                <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                   class="text-yellow-600 hover:text-yellow-700 font-semibold transition">Edit</a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center py-6 text-gray-500">No records found.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="text-center mt-10">
      <a href="{{ path('app_category_new') }}" 
         class="inline-block bg-red-600 text-white font-semibold py-2 px-6 rounded-lg hover:bg-red-700 transition">
        + Create New Cellphone Parts
      </a>
    </div>
  </div>
</section>
<script>
$(document).ready(function () {
    if (!$.fn.DataTable.isDataTable('#categoryTable')) {
        $('#categoryTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            order: [[0, 'asc']],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records..."
            }
        });
    }
});
</script>
{% endblock %}
