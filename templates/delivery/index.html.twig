{% extends 'base_dashboard.html.twig' %}

{% block title %}3D Cellshop - Deliveries{% endblock %}

{% block body %}
<section class="bg-gray-900 text-red-600 min-h-screen py-2 px-2">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-extrabold text-center text-red-600 mb-10 font-serif">Delivery Records</h1>

    <div class="overflow-x-auto bg-zinc-900 rounded-lg shadow-lg border border-red-600">
      <table id="deliveryTable" class="w-full text-sm text-left bg-white">
        <thead class="text-black bg-red-600">
          <tr>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">ID</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Customer Name</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Status</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Delivery Date</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif text-center">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800 bg-zinc-900">
          {% for delivery in deliveries %}
            <tr class="hover:bg-gray-500 transition-colors">
              <td class="px-6 py-3 text-white">{{ delivery.id }}</td>
              <td class="px-6 py-3 text-white">{{ delivery.customerName }}</td>
              <td class="px-6 py-3">
                {% if delivery.status == 'Delivered' %}
                  <span class="text-green-600 font-semibold">Delivered</span>
                {% elseif delivery.status == 'Pending' %}
                  <span class="text-yellow-400 font-semibold">Pending</span>
                {% else %}
                  <span class="text-white">{{ delivery.status }}</span>
                {% endif %}
              </td>
              <td class="px-6 py-3 text-white">
                {{ delivery.deliveryDate ? delivery.deliveryDate|date('Y-m-d H:i') : '—' }}
              </td>
              <td class="px-6 py-3 text-center space-x-3">
                <a href="{{ path('app_delivery_show', {'id': delivery.id}) }}" 
                   class="text-green-600 hover:text-green-700 font-semibold transition">Show</a>
                <a href="{{ path('app_delivery_edit', {'id': delivery.id}) }}" 
                   class="text-yellow-600 hover:text-yellow-700 font-semibold transition">Edit</a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center py-6 text-gray-400">No deliveries found.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="text-center mt-10">
      <a href="{{ path('app_delivery_new') }}" 
         class="inline-block bg-red-600 text-white font-semibold py-2 px-6 rounded-lg hover:bg-red-700 transition">
        + Create New Delivery
      </a>
    </div>
  </div>
</section>
<script>
$(document).ready(function () {
    if (!$.fn.DataTable.isDataTable('#deliveryTable')) {
        $('#deliveryTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            order: [[0, 'asc']],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search deliveries..."
            }
        });
    }
});
</script>
{% endblock %}
