{% extends 'base.html.twig' %}

{% block title %}Delivery{% endblock %}

{% block body %}
    <h1>Delivery</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ delivery.id }}</td>
            </tr>
            <tr>
                <th>CustomerName</th>
                <td>{{ delivery.customerName }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ delivery.status }}</td>
            </tr>
            <tr>
                <th>DeliveryDate</th>
                <td>{{ delivery.deliveryDate ? delivery.deliveryDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_delivery_index') }}">back to list</a>

    <a href="{{ path('app_delivery_edit', {'id': delivery.id}) }}">edit</a>

    {{ include('delivery/_delete_form.html.twig') }}
{% endblock %}
