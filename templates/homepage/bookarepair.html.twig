{% extends 'base.html.twig' %}

{% block title %}Three D Cellshop - Book a Repair{% endblock %}

{% block body %}
<section class="bg-black text-white py-20 min-h-screen">
  <div class="max-w-5xl mx-auto px-6 lg:px-12">

    <!-- Header Section -->
    <div class="text-center mb-16">
      <h1 class="text-5xl md:text-6xl font-extrabold mb-4">
        <span class="text-red-600">Book</span> a Repair
      </h1>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto">
        Having issues with your phone or tablet? Our expert technicians are here to help. 
        Fill out the form below and we’ll contact you to confirm your repair appointment.
      </p>
    </div>

    <!-- Booking Form Container -->
    <div class="bg-zinc-900/80 backdrop-blur-sm border border-red-600 rounded-2xl shadow-lg p-8 md:p-12">
      <form action="#" method="post" class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Full Name -->
        <div class="col-span-1">
          <label for="name" class="block text-sm font-semibold mb-2 text-gray-200">Full Name</label>
          <input type="text" id="name" name="name" required
                 placeholder="Enter your full name"
                 class="w-full px-4 py-3 rounded-lg bg-black text-white border border-red-600 focus:ring-2 focus:ring-red-500 outline-none placeholder-gray-500">
        </div>

        <!-- Phone Number -->
        <div class="col-span-1">
          <label for="phone" class="block text-sm font-semibold mb-2 text-gray-200">Phone Number</label>
          <input type="tel" id="phone" name="phone" required
                 placeholder="e.g. 0960 510 2266"
                 class="w-full px-4 py-3 rounded-lg bg-black text-white border border-red-600 focus:ring-2 focus:ring-red-500 outline-none placeholder-gray-500">
        </div>

        <!-- Email -->
        <div class="col-span-1">
          <label for="email" class="block text-sm font-semibold mb-2 text-gray-200">Email Address</label>
          <input type="email" id="email" name="email" required
                 placeholder="e.g. threedcellshop@gmail.com"
                 class="w-full px-4 py-3 rounded-lg bg-black text-white border border-red-600 focus:ring-2 focus:ring-red-500 outline-none placeholder-gray-500">
        </div>

        <!-- Device Model -->
        <div class="col-span-1">
          <label for="device" class="block text-sm font-semibold mb-2 text-gray-200">Device Model</label>
          <input type="text" id="device" name="device" required
                 placeholder="e.g. iPhone 14 Pro Max / Samsung S22"
                 class="w-full px-4 py-3 rounded-lg bg-black text-white border border-red-600 focus:ring-2 focus:ring-red-500 outline-none placeholder-gray-500">
        </div>

        <!-- Issue Description -->
        <div class="col-span-2">
          <label for="issue" class="block text-sm font-semibold mb-2 text-gray-200">Describe the Issue</label>
          <textarea id="issue" name="issue" rows="5" required
                    placeholder="Tell us what’s wrong with your device (e.g. cracked screen, battery not charging, water damage, etc.)"
                    class="w-full px-4 py-3 rounded-lg bg-black text-white border border-red-600 focus:ring-2 focus:ring-red-500 outline-none placeholder-gray-500"></textarea>
        </div>

        <!-- Preferred Date -->
        <div class="col-span-1">
          <label for="date" class="block text-sm font-semibold mb-2 text-gray-200">Preferred Repair Date</label>
          <input type="date" id="date" name="date"
                 class="w-full px-4 py-3 rounded-lg bg-black text-white border border-red-600 focus:ring-2 focus:ring-red-500 outline-none">
        </div>

        <!-- Preferred Time -->
        <div class="col-span-1">
          <label for="time" class="block text-sm font-semibold mb-2 text-gray-200">Preferred Time</label>
          <input type="time" id="time" name="time"
                 class="w-full px-4 py-3 rounded-lg bg-black text-white border border-red-600 focus:ring-2 focus:ring-red-500 outline-none">
        </div>

        <!-- Submit Button -->
        <div class="col-span-2 mt-6">
          <button type="submit"
                  class="w-full bg-red-600 text-white font-bold py-3 rounded-lg hover:bg-red-700 hover:scale-105 transition-transform duration-300 shadow-md">
            Submit Repair Request
          </button>
        </div>
      </form>
    </div>

    <!-- Support Info -->
    <div class="text-center mt-12 text-gray-400">
      <p>Need immediate assistance? Call us at 
        <span class="text-red-500 font-semibold">0960 510 2266</span> 
        or visit us at 
        <span class="text-red-500 font-semibold">Three D Cellshop, Perdices St, Dumaguete City</span>.
      </p>
    </div>

  </div>
</section>
{% endblock %}
