{% extends 'base.html.twig' %}
{% block title %}Three D Cellshop - About{% endblock %}

{% block body %}
<header class="relative flex flex-col items-center justify-center text-center text-white min-h-screen bg-black">
  <img src="{{ asset('image/image.png') }}" 
       class="absolute inset-0 w-full h-full object-cover opacity-60" 
       alt="Three D Cellshop Background">
  <div class="absolute inset-0 bg-black/70"></div>

  <div class="relative z-10 max-w-3xl px-6 py-16">
    <h1 class="text-5xl font-extrabold mb-6">
      <span class="text-red-600">About</span> Three D Cellshop
    </h1>
    <p class="text-gray-200 text-lg leading-relaxed">
      At <span class="font-semibold text-red-500">Three D Cellshop</span>, we are passionate about keeping your devices running at their best. 
      Our team of skilled technicians is dedicated to providing top-quality cellphone repairs, reliable accessories, 
      and exceptional customer support all at affordable prices. 
      We believe that technology should make life easier, and we’re here to ensure it always does.
    </p>
  </div>
</header>

<section class="bg-black text-white py-20 px-6">
  <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-start">
    <!-- Mission -->
    <div class="p-8 bg-zinc-900 rounded-2xl shadow-lg border-l-4 border-red-600">
      <h2 class="text-3xl font-bold mb-4 text-red-500">Our Mission</h2>
      <p class="text-gray-300 leading-relaxed">
        Our mission is to provide expert cellphone repair services, reliable accessories, and 
        customer support that exceeds expectations. We strive to blend technical expertise with 
        professional service, making technology care accessible and dependable for everyone.
      </p>
    </div>

    <!-- Vision -->
    <div class="p-8 bg-zinc-900 rounded-2xl shadow-lg border-l-4 border-red-600">
      <h2 class="text-3xl font-bold mb-4 text-red-500">Our Vision</h2>
      <p class="text-gray-300 leading-relaxed">
        Three D Cellshop envisions being the most trusted and reliable cellphone repair and 
        services provider in the region. Our goal is to deliver fast, affordable, and 
        high-quality solutions, ensuring every customer experiences convenience and satisfaction.
      </p>
    </div>
  </div>
</section>

<section class="bg-red-600 text-white py-16 text-center">
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="text-3xl font-bold mb-4">Why Choose Us?</h2>
    <p class="text-lg text-gray-100 leading-relaxed">
      We combine years of experience, advanced repair tools, and genuine customer care to deliver 
      unmatched service quality. Whether it’s a cracked screen, a dying battery, or the latest 
      accessory Three D Cellshop is your trusted partner in mobile solutions.
    </p>
  </div>
</section>
{% endblock %}
