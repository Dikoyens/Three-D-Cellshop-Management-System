{% extends 'base.html.twig' %}

{% block title %}Log in | Three D Cellshop{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-black via-zinc-900 to-black py-10">

    <div class="w-full max-w-md bg-white shadow-2xl rounded-2xl p-8 border border-red-600">
        
        <h1 class="text-3xl font-extrabold text-center text-red-600 mb-8 tracking-wide">
            Three D Cellshop
        </h1>

        <p class="text-center text-gray-600 text-sm mb-6">
            🔐 Sign in to access your dashboard
        </p>

        <!-- ✅ Flash messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="bg-red-500 text-white p-3 rounded-lg mb-4 text-sm font-semibold shadow-md">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if error %}
            <div class="bg-red-600 text-white p-3 rounded-lg mb-4 text-sm font-semibold shadow-md">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="space-y-5">
            <div>
                <label for="inputEmail" class="block text-gray-700 font-semibold mb-1">Email</label>
                <input 
                    type="email" 
                    id="inputEmail"
                    name="email"
                    value="{{ last_username }}"
                    class="w-full px-4 py-2 rounded-lg border-2 border-gray-300 focus:border-red-600 focus:ring-0 outline-none transition"
                    required autofocus
                >
            </div>

            <div>
                <label for="inputPassword" class="block text-gray-700 font-semibold mb-1">Password</label>
                <input 
                    type="password"
                    id="inputPassword"
                    name="password"
                    class="w-full px-4 py-2 rounded-lg border-2 border-gray-300 focus:border-red-600 focus:ring-0 outline-none transition"
                    required
                >
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center text-gray-600 text-sm select-none">
                    <input type="checkbox" name="_remember_me" class="mr-2">
                    Remember me
                </label>
            </div>

            <!-- ✅ CSRF Token -->
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button 
                class="w-full bg-red-600 hover:bg-red-700 text-white py-3 rounded-lg font-bold shadow-md transition-transform hover:scale-[1.02]">
                Sign In
            </button>
        </form>

        <p class="text-center text-gray-600 text-sm mt-6">
            Don’t have an account?
            <a href="{{ path('app_register') }}" class="text-red-600 hover:text-red-700 hover:underline font-bold">
                Register here
            </a>
        </p>

        <p class="text-center mt-3">
            <a href="#" class="text-sm text-gray-500 hover:underline">Forgot password?</a>
        </p>

    </div>
</div>
{% endblock %}
