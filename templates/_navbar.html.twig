<nav class="bg-black text-white py-4 shadow-md">
  <div class="container mx-auto flex justify-between items-center px-6">

    <!-- LEFT: LOGO -->
    <a href="{{ path('app_homepage') }}" class="flex items-center space-x-2">
      <img src="{{ asset('image/logo.png') }}" alt="logo" class="w-8 h-8 rounded-md">
      <span class="text-2xl font-serif text-red-600 hover:text-red-700">
        Three D Cellshop
      </span>
    </a>

    <!-- CENTER NAVIGATION (changes by route) -->
    <div class="flex items-center space-x-4 font-serif">
      {% if app.request.attributes.get('_route') starts with 'app_homepage' 
          or app.request.attributes.get('_route') starts with 'about' 
          or app.request.attributes.get('_route') starts with 'contact'
          or app.request.attributes.get('_route') starts with 'services' %}
          
          <a href="{{ path('app_homepage') }}" class="hover:text-red-500">Home</a>
          <a href="{{ path('about') }}" class="hover:text-red-500">About</a>
          <a href="{{ path('contact') }}" class="hover:text-red-500">Contact</a>
          <a href="{{ path('services') }}" class="hover:text-red-500">Services</a>
      {% endif %}
    </div>

    <!-- RIGHT: AUTH BUTTONS -->
     <div class="flex items-center space-x-4">
      {% if app.user %}
        <!-- Logged-in user dropdown -->
        <div class="relative group">
          <button class="flex items-center space-x-2 p-2 rounded-full hover:bg-gray-800 transition">
            <!-- Profile Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2a5 5 0 015 5v1a5 5 0 01-10 0V7a5 5 0 015-5zm0 12a9 9 0 00-9 9 1 1 0 001 1h16a1 1 0 001-1 9 9 0 00-9-9z" clip-rule="evenodd"/>
            </svg>
            <span class="font-serif">{{ app.user.userIdentifier }}</span>
            <!-- Dropdown arrow -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover:rotate-180 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown menu -->
          <div class="absolute right-0 mt-2 w-48 bg-gray-900 rounded-md shadow-lg opacity-0 group-hover:opacity-100 invisible group-hover:visible transition duration-300 z-50">
            <a href="{{ path('app_dashboard_index') }}" class="block px-4 py-2 hover:bg-gray-800">Dashboard</a>
            <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-red-400 hover:bg-gray-800">Logout</a>
          </div>
        </div>
      {% else %}
        <!-- When not logged in -->
        <a href="{{ path('app_login') }}" class="flex items-center space-x-2 bg-red-600 hover:bg-red-700 px-3 py-2 rounded-md transition">
          <!-- Login Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M16 13v-2H7V8l-5 4 5 4v-3h9zM20 3h-8v2h8v14h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
          </svg>
          <span>Login</span>
        </a>

        <a href="{{ path('app_register') }}" class="flex items-center space-x-2 border border-red-600 hover:bg-red-700 px-3 py-2 rounded-md transition">
          <!-- Signup Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M15 14c2.7 0 8 1.34 8 4v2H7v-2c0-2.66 5.3-4 8-4zM15 12a4 4 0 100-8 4 4 0 000 8zM3 10h2V8h2V6H5V4H3v2H1v2h2v2z"/>
          </svg>
          <span>Sign Up</span>
        </a>
      {% endif %}
    </div>
  </div>
</nav>
