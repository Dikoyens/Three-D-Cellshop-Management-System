{% extends 'base.html.twig' %}

{% block title %}Register | Three D Cellshop{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-screen bg-black">
    <div class="bg-zinc-900 border border-red-600 rounded-2xl p-10 w-full max-w-md text-white shadow-2xl">
        <h1 class="text-center text-3xl font-bold mb-6 text-red-600">Create an Account</h1>

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}

            <div>
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'text-white font-semibold'}}) }}
                {{ form_widget(registrationForm.email, {
                    'attr': {
                        'class': 'w-full p-3 rounded-md bg-black border border-red-600 text-white focus:outline-none focus:ring focus:ring-red-600'
                    }
                }) }}
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'text-white font-semibold'}}) }}
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'class': 'w-full p-3 rounded-md bg-black border border-red-600 text-white focus:outline-none focus:ring focus:ring-red-600'
                    }
                }) }}
            </div>

            <div class="flex items-center gap-3">
                {{ form_widget(registrationForm.agreeTerms, {
                    'attr': {'class': 'rounded border-red-600'}
                }) }}
                {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'text-white'}}) }}
            </div>

            <button type="submit"
                    class="w-full mt-4 bg-red-600 hover:bg-red-700 transition text-white font-semibold py-3 rounded-md shadow-lg">
                Register
            </button>

        {{ form_end(registrationForm) }}

        <div class="text-center mt-4">
            <p class="text-gray-400">Already have an account?
                <a href="{{ path('app_login') }}" class="text-red-500 font-semibold hover:underline">
                    Login here
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
