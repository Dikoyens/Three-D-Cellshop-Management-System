{% extends 'base.html.twig' %}

{% block title %}Create Repair Record | Three D Cellshop{% endblock %}

{% block body %}
<section class="min-h-screen bg-black flex items-center justify-center py-12 px-6">
  <div class="bg-zinc-600 w-full max-w-2xl rounded-2xl shadow-2xl p-10 border border-red-600">
    <h1 class="text-3xl font-bold text-center text-red-600 mb-8 tracking-wide">
      Create New Repair Record
    </h1>

    <div class="text-gray-300 text-center mb-6">
      Fill out the form below to log a new repair record for a customer.
    </div>

    <div class="space-y-6 text-black">
      {{ include('repair_record/_form.html.twig', {
        button_label: 'Save Record'
      }) }}
    </div>

    <div class="flex justify-center mt-8">
      <a href="{{ path('app_repair_record_index') }}" 
         class="text-red-600 hover:text-red-700 transition font-medium">
        ← Back to List
      </a>
    </div>
  </div>
</section>
{% endblock %}
