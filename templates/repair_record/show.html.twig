{% extends 'base_dashboard.html.twig' %}

{% block title %}Repair Record Details | {{ parent() }}{% endblock %}

{% block body %}
<div class="min-h-screen text-gray-100 flex items-center justify-center py-2">
    <div class="w-full max-w-3xl bg-zinc-900 rounded-2xl shadow-xl border border-zinc-800 overflow-hidden">
        <!-- Header -->
        <div class="flex items-center justify-between p-6 border-b border-zinc-800">
            <h1 class="text-2xl font-semibold text-white">Repair Record Details</h1>
            <a href="{{ path('app_repair_record_index') }}" 
               class="text-sm font-medium text-red-500 hover:text-red-400 transition-colors">
                ← Back to List
            </a>
        </div>

        <!-- Details Table -->
        <div class="p-6">
            <table class="w-full border-collapse">
                <tbody class="divide-y divide-zinc-800">
                    <tr>
                        <th class="text-left py-3 px-2 font-medium text-gray-400 w-1/3">ID</th>
                        <td class="py-3 px-2">{{ repair_record.id }}</td>
                    </tr>
                    <tr>
                        <th class="text-left py-3 px-2 font-medium text-gray-400">Customer Name</th>
                        <td class="py-3 px-2">{{ repair_record.customerName }}</td>
                    </tr>
                    <tr>
                        <th class="text-left py-3 px-2 font-medium text-gray-400">Mobile Number</th>
                        <td class="py-3 px-2">{{ repair_record.mobileNumber }}</td>
                    </tr>
                    <tr>
                        <th class="text-left py-3 px-2 font-medium text-gray-400">Repair Details</th>
                        <td class="py-3 px-2">{{ repair_record.repairDetails }}</td>
                    </tr>
                    <tr>
                        <th class="text-left py-3 px-2 font-medium text-gray-400">Down Payment</th>
                        <td class="py-3 px-2 text-red-400 font-semibold">
                            {{ repair_record.paymentMethod }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Actions -->
        <div class="flex justify-between items-center border-t border-zinc-800 p-6">
            <div class="flex gap-4">
                <a href="{{ path('app_repair_record_edit', {'id': repair_record.id}) }}" 
                   class="px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg transition">
                    Edit
                </a>
                {{ include('repair_record/_delete_form.html.twig', { 
                    'button_class': 'px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-sm text-gray-100 rounded-lg transition' 
                }) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
