{% extends 'base_dashboard.html.twig' %}

{% block title %}3D Cellshop - Repair Records{% endblock %}

{% block body %}
<section class="bg-gray-900 text-red-700 min-h-screen py-2 px-2">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-extrabold text-center text-red-600 mb-10 font-serif">Repair Record Index</h1>

    <div class="overflow-x-auto bg-zinc-900 rounded-lg shadow-lg border border-red-600">
      <table  id="repairrecordTable"class="w-full text-sm text-left bg-white" >
        <thead class="text-black bg-red-700">
          <tr>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">ID</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Customer Name</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Mobile Number</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Repair Details</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Cellphone Parts</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif">Payment Method</th>
            <th scope="col" class="px-6 py-3 font-semibold font-serif text-center">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800 bg-zinc-900">
          {% for repair_record in repair_records %}
            <tr class="hover:bg-gray-500 transition-colors">
              <td class="px-6 py-3 text-white">{{ repair_record.id }}</td>
              <td class="px-6 py-3 text-white">{{ repair_record.customerName }}</td>
              <td class="px-6 py-3 text-white">{{ repair_record.mobileNumber }}</td>
              <td class="px-6 py-3 text-white">{{ repair_record.repairDetails }}</td>
              <td class="px-6 py-3 text-white">{{ repair_record.Category }}</td>
              <td class="px-6 py-3 text-white">{{ repair_record.paymentMethod }}</td>
              <td class="px-6 py-3 text-center space-x-3">
                <a href="{{ path('app_repair_record_show', {'id': repair_record.id}) }}" 
                   class="text-green-600 hover:text-green-700 font-semibold transition">Show</a>
                <a href="{{ path('app_repair_record_edit', {'id': repair_record.id}) }}" 
                   class="text-yellow-600 hover:text-yellow-700 font-semibold transition">Edit</a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="text-center py-6 text-gray-400">No records found.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="text-center mt-10">
      <a href="{{ path('app_repair_record_new') }}" 
         class="inline-block bg-red-600 text-white font-semibold py-2 px-6 rounded-lg hover:bg-red-700 transition">
        + Create New Record
      </a>
    </div>
  </div>
</section>
<script>
$(document).ready(function () {
    if (!$.fn.DataTable.isDataTable('#repairrecordTable')) {
        $('#repairrecordTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            order: [[0, 'asc']],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records..."
            }
        });
    }
});
</script>

{% endblock %}
